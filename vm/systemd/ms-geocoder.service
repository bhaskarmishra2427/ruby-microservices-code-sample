[Unit]
Description=ms-geocoder (Sinatra, AMQP consumer on queue "geocoding")
Documentation=file://__ROOT__/dev/README.md
After=network-online.target rabbitmq-server.service
Wants=network-online.target
Requires=rabbitmq-server.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__/geocoder
EnvironmentFile=/etc/newrelic-ms/env
Environment=PORT=6000
ExecStart=__HOME__/.rbenv/shims/bundle exec puma -C config/puma.rb
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ms-geocoder

[Install]
WantedBy=multi-user.target
