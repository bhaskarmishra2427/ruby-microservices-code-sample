# Shared environment for the three Ruby services. Copy to dev/env and adjust.
#
# Plain KEY=value, no `export` and no interpolation, so this one file works both
# as a shell source (via `set -a`) and as a systemd EnvironmentFile. On the VM it
# is installed to /etc/newrelic-ms/env; see vm/README.md.
#
# RACK_ENV=production is deliberate, for two reasons:
#   1. geocoder/config/settings/ contains only production.yml, so development mode
#      would need new settings files for both geocoder and auth.
#   2. development mode enables Sinatra::Reloader, which stats files on every
#      request and would distort load test numbers.

RACK_ENV=production

# Required. geocoder reads db/data/city.csv, which is UTF-8 Cyrillic; without a
# UTF-8 locale Ruby's default_external is US-ASCII and CSV.read raises
# CSV::InvalidEncodingError, so every geocoding message fails. The official Ruby
# Docker images set LANG=C.UTF-8 for the same reason.
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8

# --- PostgreSQL ------------------------------------------------------------
# Databases: ms-ads-production (ads, ActiveRecord) and ms-auth (auth, Sequel),
# both owned by the ads role.
DATABASE_HOST=localhost
PG_USER=ads
PG_PASSWORD=ads

# --- RabbitMQ --------------------------------------------------------------
# guest/guest is accepted on loopback, which is where everything runs, so no
# user provisioning is needed.
RABBITMQ_HOST=localhost
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBIT_MQ_CONSUMER_POOL=5

# --- Cross-service topology ------------------------------------------------
# The async path: ads -> auth over AMQP RPC, ads -> geocoder over a durable
# queue, then geocoder -> ads back over HTTP (which has no queue alternative).
AUTH_METHOD=sync_rpc
GEOCODE_METHOD=async_publish_to_queue

# Bounds the RPC reply wait. Without it a missing reply blocks a Puma thread
# forever; see ads/app/lib/auth_service/rpc_client.rb.
AUTH_RPC_TIMEOUT=5

# --- Puma (ads) ------------------------------------------------------------
# Every POST /ads holds a thread for a blocking AMQP RPC, and geocoder's PUT
# callbacks land in the same pool. At Puma's default of 5 the two starve each
# other; see loadtest/results/README.md.
PUMA_MIN_THREADS=5
PUMA_MAX_THREADS=16

# --- Secrets ---------------------------------------------------------------
# Throwaway values. Fine for an SSH-only box with no inbound database port;
# change them if the host becomes long-lived or gains wider exposure.
#
# GEOCODER_SECRET is shared by two services: geocoder sends it as the
# AUTHORIZATION header on its callback, and ads compares the header against it.
# A mismatch makes every callback 403 and silently leaves lat/lon null.
GEOCODER_SECRET=dev-geocoder-secret

# JWT signing key for auth.
APP_SECRET=dev-jwt-secret

# --- Logging ---------------------------------------------------------------
# APP_NAME only affects ads; auth and geocoder take their service name from
# their own settings.yml. In production mode all three log JSON to stdout.
APP_NAME=ads
LOG_LEVEL=info
LOG_PATH=log/app.log
